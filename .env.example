# Password for the 'elastic' user (at least 6 characters)
ELASTIC_PASSWORD=example

# Password for the 'kibana_system' user (at least 6 characters)
KIBANA_PASSWORD=example

# Version of Elastic products
STACK_VERSION=9.5.5

# Set the cluster name
CLUSTER_NAME=docker-cluster

# Set to 'basic' or 'trial' to automatically start the 30-day trial
LICENSE=trial
#LICENSE=trial

# Port to expose Elasticsearch HTTP API to the host
ES_PORT=9200
#ES_PORT=127.0.0.1:9200

# Port to expose Kibana to the host
KIBANA_PORT=5601
#KIBANA_PORT=80

# Increase or decrease based on the available host memory (in bytes)
MEM_LIMIT=1073741824
# RAM-Limit für den Kibana Container
KIBANA_MEM_LIMIT=3g

# Project namespace (defaults to the current folder name if not set)
#COMPOSE_PROJECT_NAME=myproject

# Root Benutzer für den MinIO S3-Kompatiblen Storage
MINIO_ROOT_USER=elasticminio

# Root Passwort für den MinIO S3-Kompatiblen Storage
MINIO_ROOT_PASSWORD=example

# Encryption key für Kibana (min 32 Zeichen)
KIBANA_ENCRYPTION_KEY=example

# Service token für die Authentifizierung des Fleet Server an Elasticsearch
FLEET_SERVER_SERVICE_TOKEN=example

# ID der Fleet Server agent policy
FLEET_SERVER_POLICY_ID=d0fd2eca-e630-4360-a37a-90bcb0055bbb

# Token für die Registrierung von Elastic Agents am Fleet-Server
FLEET_AGENT_ENROLLMENT_TOKEN=example
